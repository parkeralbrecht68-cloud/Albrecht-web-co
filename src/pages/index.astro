---
// EDIT YOUR BUSINESS DETAILS HERE.
const email = "YOUR_EMAIL_HERE";
const emailReady = email !== "YOUR_EMAIL_HERE" && email.includes("@");
const emailLink = `mailto:${email}?subject=Website%20project%20inquiry`;
const year = new Date().getFullYear();

// Replace "Custom quote" with your prices whenever you are ready.
const services = [
  {
    number: "01",
    title: "The essential website",
    description: "A focused, professional presence that introduces your business and makes the next step clear.",
    features: ["Custom single-page design", "Mobile-friendly layout", "Clear contact links"],
    price: "Custom quote",
  },
  {
    number: "02",
    title: "The business website",
    description: "Room to tell your story, explain your services, and give customers confidence in your business.",
    features: ["Multiple custom pages", "Search-friendly page structure", "A design built around your brand"],
    price: "Custom quote",
  },
  {
    number: "03",
    title: "The fresh start",
    description: "An intentional redesign for an existing website that no longer reflects the quality of your work.",
    features: ["Updated visual direction", "Simplified navigation", "A better mobile experience"],
    price: "Custom quote",
  },
];

const projects = [
  {
    number: "01",
    name: "Last Round LLC",
    type: "Nightlife platform",
    status: "LIVE",
    theme: "last-round",
    url: "https://lastroundllc.com/",
    description: "A nightlife platform built around discovering local spots, planning the night, tracking drinks, coordinating with friends, and giving bars and restaurants a stronger way to reach customers.",
    features: ["Venue discovery", "Drink & night tracking", "Business listing tools"],
  },
  {
    number: "02",
    name: "RotateIQ",
    type: "Competitive gaming tool",
    status: "BUILT",
    theme: "rotate-iq",
    url: "",
    description: "A Fortnite rotation-planning experience designed to help competitive players read zones, compare safer paths, account for terrain and traffic, and make smarter movement decisions.",
    features: ["Interactive zone planning", "Route & timing tools", "Traffic visualization"],
  },
  {
    number: "03",
    name: "Wick",
    type: "Trading education platform",
    status: "IN DEVELOPMENT",
    theme: "wick",
    url: "",
    description: "An interactive trading education platform that breaks down day trading, memecoins, market concepts, and risk in a way newer traders can understand, with an AI coach built into the experience.",
    features: ["Trading education", "Interactive market tools", "AI coaching"],
  },
];

const steps = [
  {
    title: "Talk it through.",
    text: "We start with your business, your customers, and what your website needs to do.",
  },
  {
    title: "Build with purpose.",
    text: "Your content and design come together, with room for your feedback along the way.",
  },
  {
    title: "Launch with confidence.",
    text: "We review the details together and get your new website ready for the world.",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#101d31" />
    <meta
      name="description"
      content="Albrecht Web Co. is a military-owned web design business creating clean, professional websites for businesses ready to make a stronger first impression."
    />
    <title>Albrecht Web Co. | Military-Owned Web Design</title>
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="header">
      <div class="container navigation">
        <a class="brand" href="#home" aria-label="Albrecht Web Co. home">
          <span class="brand-mark" aria-hidden="true">A<span>.</span></span>
          <span>ALBRECHT<small>WEB CO.</small></span>
        </a>

        <nav aria-label="Main navigation">
          <a href="#services">Services</a>
          <a href="#about">About</a>
          <a href="#work">Work</a>
          <a href="#process">Process</a>
          <a class="nav-contact" href="#contact">
            Let’s talk <span aria-hidden="true">↗</span>
          </a>
        </nav>
      </div>
    </header>

    <main id="main">
      <section class="hero" id="home" aria-labelledby="hero-title">
        <div class="container">
          <div class="ownership">
            <span aria-hidden="true">🇺🇸</span>
            Military-owned. Detail-driven.
          </div>

          <div class="hero-grid">
            <div>
              <p class="eyebrow">Independent web design</p>

              <h1 id="hero-title">
                Your business.<br />
                A stronger<br />
                <span>first impression.</span>
              </h1>

              <p class="hero-copy">
                You put pride into your work. Your website should show it.
                Custom websites built with clarity, purpose, and attention
                to the details.
              </p>

              <div class="actions">
                <a class="button button-red" href="#contact">
                  Start your project <span aria-hidden="true">↗</span>
                </a>
                <a class="text-link" href="#services">
                  Explore services <span aria-hidden="true">↓</span>
                </a>
              </div>
            </div>

            <aside class="mission" aria-label="Our approach">
              <span class="mission-label">THE ALBRECHT APPROACH</span>

              <p class="mission-heading">
                Good design.<br />
                Clear purpose.<br />
                <span>No shortcuts.</span>
              </p>

              <div class="mission-rule"></div>

              <p>
                A website should feel like your business at its best.
                Thoughtful design, straightforward communication, and a
                clear path from first visit to first conversation.
              </p>

              <span class="mission-signature">
                Built with pride. Built for you.
              </span>
            </aside>
          </div>

          <div class="hero-bottom">
            <span>Small businesses. Strong foundations.</span>
            <a href="#services">
              Discover the details <span aria-hidden="true">↓</span>
            </a>
          </div>
        </div>
      </section>

      <section class="section" id="services" aria-labelledby="services-title">
        <div class="container">
          <div class="section-heading">
            <div>
              <p class="eyebrow">01 / Services</p>
              <h2 id="services-title">
                A better home<br />for your business.
              </h2>
            </div>
            <p>
              Whether you’re getting started or ready for a new direction,
              we’ll build around what your business needs.
            </p>
          </div>

          <div class="service-grid">
            {services.map((service) => (
              <article class="service-card">
                <span class="service-number">/ {service.number}</span>
                <h3>{service.title}</h3>
                <p>{service.description}</p>

                <ul>
                  {service.features.map((feature) => <li>{feature}</li>)}
                </ul>

                <div class="service-footer">
                  <strong>{service.price}</strong>
                  <a
                    href="#contact"
                    aria-label={`Discuss ${service.title.toLowerCase()}`}
                  >
                    Let’s talk <span aria-hidden="true">↗</span>
                  </a>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="section about" id="about" aria-labelledby="about-title">
        <div class="container about-grid">
          <div>
            <p class="eyebrow">02 / Our foundation</p>
            <h2 id="about-title">
              Military-owned.<br />
              <span class="muted">Personally invested.</span>
            </h2>
          </div>

          <div class="about-copy">
            <p class="lead">
              Behind every business is someone who cares deeply about getting
              it right. We bring that same mindset to your website.
            </p>
            <p>
              Albrecht Web Co. brings a military perspective to web design:
              preparation, accountability, and pride in the finished work.
              We believe in keeping the process clear and treating the
              details like they matter. Because they do.
            </p>

            <div class="values">
              <span>Discipline</span>
              <span>Integrity</span>
              <span>Attention to detail</span>
            </div>
          </div>
        </div>
      </section>

      <section class="section work-section" id="work" aria-labelledby="work-title">
        <div class="container">
          <div class="section-heading work-heading">
            <div>
              <p class="eyebrow">03 / Selected work</p>
              <h2 id="work-title">Built beyond the brief.</h2>
            </div>
            <p>
              Three original products, three completely different problems.
              Each one was designed around a real use case instead of a template.
            </p>
          </div>

          <div class="project-grid">
            {projects.map((project) => (
              <article class:list={["project-card", `project-card--${project.theme}`]}>
                <div class="project-showcase" aria-hidden="true">
                  <div class="mock-browser">
                    <div class="mock-browser-bar">
                      <span></span><span></span><span></span>
                      <i></i>
                    </div>

                    {project.theme === "last-round" ? (
                      <div class="last-round-preview">
                        <div class="preview-brand">
                          <strong>LAST ROUND</strong>
                          <span>TONIGHT · DISCOVER · CREW</span>
                        </div>
                        <div class="last-round-grid">
                          <div class="last-round-hero">
                            <small>THE NIGHT IS YOURS</small>
                            <strong>Make tonight a good one.</strong>
                            <span>Find your spot. Bring your people.</span>
                          </div>
                          <div class="last-round-stat">
                            <small>YOUR NIGHT</small>
                            <strong>0</strong>
                            <span>drinks logged</span>
                          </div>
                        </div>
                      </div>
                    ) : project.theme === "rotate-iq" ? (
                      <div class="rotate-preview">
                        <div class="preview-brand rotate-brand">
                          <strong>ROTATE <em>IQ</em></strong>
                          <span>TERRAIN · TIMING · POSITION</span>
                        </div>
                        <div class="rotate-map">
                          <span class="rotate-zone"></span>
                          <span class="rotate-player"></span>
                          <span class="rotate-route"></span>
                          <i class="enemy enemy-one"></i>
                          <i class="enemy enemy-two"></i>
                          <i class="enemy enemy-three"></i>
                          <b>SAFER ROTATION</b>
                        </div>
                      </div>
                    ) : (
                      <div class="wick-preview">
                        <div class="preview-brand wick-brand">
                          <strong>WICK</strong>
                          <span>AI COACH · MARKET LAB</span>
                        </div>
                        <div class="wick-grid">
                          <div class="wick-chart">
                            <span></span><span></span><span></span><span></span><span></span><span></span><span></span>
                            <svg viewBox="0 0 240 90" preserveAspectRatio="none">
                              <path d="M0 72 C32 63 48 70 70 48 S110 58 132 38 S175 48 198 22 S226 31 240 11" />
                            </svg>
                          </div>
                          <div class="wick-coach">
                            <small>AI COACH</small>
                            <strong>Build the plan before the trade.</strong>
                            <i></i>
                          </div>
                        </div>
                      </div>
                    )}
                  </div>
                </div>

                <div class="project-content">
                  <div class="project-meta">
                    <span>PROJECT {project.number}</span>
                    <span>{project.status}</span>
                  </div>
                  <p class="project-type">{project.type}</p>
                  <h3>{project.name}</h3>
                  <p class="project-description">{project.description}</p>
                  <ul class="project-features">
                    {project.features.map((feature) => <li>{feature}</li>)}
                  </ul>
                  {project.url ? (
                    <a class="project-link" href={project.url} target="_blank" rel="noopener noreferrer">
                      Visit live site <span aria-hidden="true">↗</span>
                    </a>
                  ) : (
                    <span class="project-link project-link-muted">Public link coming soon</span>
                  )}
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="section" id="process" aria-labelledby="process-title">
        <div class="container">
          <div class="section-heading">
            <div>
              <p class="eyebrow">04 / The process</p>
              <h2 id="process-title">Clear from day one.</h2>
            </div>
            <p>
              You know your business. We’ll help turn that knowledge into
              a website you’re proud to share.
            </p>
          </div>

          <div class="steps">
            {steps.map((step, index) => (
              <article class="step">
                <span class="step-number">0{index + 1}</span>
                <h3>{step.title}</h3>
                <p>{step.text}</p>
              </article>
            ))}
          </div>

          <div class="questions">
            <details>
              <summary>Can you work with my existing website?</summary>
              <p>
                Yes. We can discuss a redesign or a fresh build based on
                what you have now and where you want to take your business.
              </p>
            </details>

            <details>
              <summary>What do I need to get started?</summary>
              <p>
                A short description of your business and what you want your
                website to accomplish. If you have a logo, photos, or an
                existing site, those are helpful starting points.
              </p>
            </details>

            <details>
              <summary>How much will my website cost?</summary>
              <p>
                Pricing depends on the pages, content, and features your
                project needs. We’ll discuss the scope and provide a quote
                before work begins.
              </p>
            </details>
          </div>
        </div>
      </section>

      <section class="contact section" id="contact" aria-labelledby="contact-title">
        <div class="container contact-grid">
          <div>
            <p class="eyebrow">Let’s build something you’re proud of</p>
            <h2 id="contact-title">
              Ready for your<br /><span>next chapter?</span>
            </h2>
            <p>Tell us about your business and what you have in mind.</p>
          </div>

          <div class="contact-action">
            {emailReady ? (
              <>
                <a class="button button-red" href={emailLink}>
                  Let’s talk about your website
                  <span aria-hidden="true">↗</span>
                </a>
                <a class="email-link" href={emailLink}>{email}</a>
              </>
            ) : (
              <p class="contact-note">Project inquiries opening soon.</p>
            )}
          </div>
        </div>
      </section>
    </main>

    <footer>
      <div class="container footer-inner">
        <a class="footer-brand" href="#home">ALBRECHT WEB CO.</a>
        <p>© {year} Albrecht Web Co. All rights reserved.</p>
        <span>
          <span aria-hidden="true">🇺🇸</span> Proudly military-owned.
        </span>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --navy: #101d31;
    --ink: #142139;
    --red: #bd343f;
    --muted: #5c6676;
    --line: #dce1e8;
    --paper: #f3f5f8;
  }

  *, *::before, *::after { box-sizing: border-box; }

  html {
    scroll-behavior: smooth;
    scroll-padding-top: 120px;
  }

  body {
    margin: 0;
    background: #fff;
    color: var(--ink);
    font-family: Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 16px;
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
  }

  h1, h2, h3, p { margin: 0; }
  a { color: inherit; text-decoration: none; }
  a, summary { -webkit-tap-highlight-color: transparent; }

  a:focus-visible, summary:focus-visible {
    outline: 3px solid #347fd1;
    outline-offset: 6px;
  }

  ::selection { background: #bd343f; color: #fff; }

  .container {
    width: min(1180px, calc(100% - 64px));
    margin-inline: auto;
  }

  .skip-link {
    position: fixed;
    top: 12px;
    left: 12px;
    z-index: 100;
    padding: 12px 20px;
    background: #fff;
    color: var(--ink);
    transform: translateY(-180%);
  }

  .skip-link:focus { transform: translateY(0); }

  .header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: #fff;
    border-bottom: 1px solid var(--line);
  }

  .navigation {
    min-height: 92px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 13px;
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: .1em;
    line-height: 1.25;
  }

  .brand-mark {
    display: grid;
    place-items: center;
    position: relative;
    width: 46px;
    height: 46px;
    background: var(--navy);
    color: #fff;
    font-size: 2rem;
    letter-spacing: -.12em;
    padding-right: 8px;
  }

  .brand-mark span {
    position: absolute;
    right: 8px;
    bottom: 5px;
    color: #ed7b83;
  }

  .brand small {
    display: block;
    margin-top: 5px;
    font-size: .75rem;
    letter-spacing: .24em;
    font-weight: 500;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 28px;
    font-size: .875rem;
    font-weight: 600;
  }

  nav a { padding-block: 12px; }
  nav a:hover { color: var(--red); }

  nav .nav-contact {
    padding: 11px 18px;
    border: 1px solid var(--line);
  }

  .nav-contact span { margin-left: 12px; }

  .hero {
    position: relative;
    overflow: hidden;
    padding: 56px 0 0;
    color: #fff;
    background: radial-gradient(ellipse at 90% 25%, #253b56 0, transparent 55%), var(--navy);
  }

  .hero::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 26%;
    height: 4px;
    background: var(--red);
  }

  .ownership {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 13px;
    border: 1px solid #647186;
    border-radius: 3px;
    font-size: .875rem;
    color: #e1e7ee;
  }

  .ownership > span { font-size: 1.125rem; }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.55fr 1fr;
    gap: clamp(36px, 6vw, 96px);
    align-items: center;
    padding: 42px 0 76px;
  }

  .hero-grid > *, .about-grid > *, .contact-grid > * { min-width: 0; }

  .eyebrow {
    font-size: .75rem;
    font-weight: 700;
    letter-spacing: .16em;
    text-transform: uppercase;
    margin-bottom: 20px;
    color: var(--red);
  }

  .hero .eyebrow, .contact .eyebrow { color: #eaa1a8; }

  h1 {
    font-size: clamp(2.8rem, 5.6vw, 4.65rem);
    font-weight: 750;
    line-height: 1.07;
    letter-spacing: -.055em;
  }

  h1 > span { color: #afc2d7; }

  .hero-copy {
    max-width: 510px;
    margin-top: 28px;
    color: #c7d1de;
    font-size: 1.125rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 24px;
    margin-top: 34px;
  }

  .button {
    min-height: 52px;
    display: inline-flex;
    justify-content: center;
    align-items: center;
    gap: 22px;
    padding: 14px 24px;
    font-size: .9375rem;
    font-weight: 650;
    border-radius: 3px;
    transition: background .2s, transform .2s;
  }

  .button-red { background: var(--red); color: #fff; }
  .button-red:hover { background: #a62934; transform: translateY(-2px); }
  .text-link { font-size: .9375rem; padding-block: 12px; }
  .text-link span { margin-left: 10px; }
  .text-link:hover { text-decoration: underline; text-underline-offset: 5px; }

  .mission {
    border-left: 1px solid #627188;
    padding: 18px 0 18px 36px;
  }

  .mission-label {
    font-size: .75rem;
    letter-spacing: .15em;
    color: #b7c7d8;
  }

  .mission-heading {
    margin-top: 26px;
    font-size: clamp(1.8rem, 3vw, 2.7rem);
    line-height: 1.2;
    font-weight: 600;
    letter-spacing: -.035em;
  }

  .mission-heading span { color: #b7c7d8; }

  .mission-rule {
    width: 44px;
    height: 3px;
    background: #d05b65;
    margin: 28px 0;
  }

  .mission > p:not(.mission-heading) { color: #c7d1de; }

  .mission-signature {
    display: block;
    font-size: .875rem;
    margin-top: 24px;
    color: #e3eaf2;
  }

  .hero-bottom {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    padding: 21px 0;
    border-top: 1px solid #536176;
    color: #c7d1de;
    font-size: .875rem;
  }

  .hero-bottom a:hover { color: #fff; }
  .hero-bottom a span { margin-left: 14px; }
  .section { padding-block: 100px; }

  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 40px;
    margin-bottom: 44px;
  }

  h2 {
    font-size: clamp(2rem, 3.8vw, 3.25rem);
    line-height: 1.12;
    letter-spacing: -.045em;
    font-weight: 700;
  }

  .section-heading > p { max-width: 350px; color: var(--muted); }

  .service-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }

  .service-card {
    display: flex;
    flex-direction: column;
    padding: 30px;
    border: 1px solid var(--line);
    border-radius: 4px;
    transition: border-color .2s, transform .2s, box-shadow .2s;
  }

  .service-card:hover {
    border-color: #99a9bc;
    transform: translateY(-4px);
    box-shadow: 0 12px 32px #1421390a;
  }

  .service-number {
    color: var(--red);
    font-size: .875rem;
    font-weight: 700;
    margin-bottom: 34px;
  }

  h3 {
    font-size: 1.3rem;
    line-height: 1.3;
    letter-spacing: -.025em;
    margin-bottom: 15px;
  }

  .service-card > p, .step p { color: var(--muted); }

  .service-card ul {
    list-style: none;
    padding: 0;
    margin: 26px 0 32px;
  }

  .service-card li {
    position: relative;
    padding-left: 21px;
    margin-top: 10px;
    font-size: .875rem;
  }

  .service-card li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: var(--red);
    font-weight: 700;
  }

  .service-footer {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
    padding-top: 22px;
    border-top: 1px solid var(--line);
    font-size: .875rem;
  }

  .service-footer a {
    color: var(--red);
    font-weight: 650;
    padding-block: 6px;
  }

  .service-footer a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .about {
    background: var(--paper);
    border-block: 1px solid var(--line);
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
  }

  .muted { color: var(--muted); }

  .about-copy .lead {
    font-size: 1.3rem;
    line-height: 1.55;
    color: var(--ink);
  }

  .about-copy > p + p { margin-top: 20px; color: var(--muted); }

  .values {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 28px;
  }

  .values span {
    padding: 7px 12px;
    border: 1px solid #cbd3de;
    font-size: .875rem;
    border-radius: 3px;
  }

  .work-section {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(circle at 88% 12%, #213652 0, transparent 33%),
