---
// ALBRECHT WEB CO. — complete, self-contained Astro page.
// Replace ALL of src/pages/index.astro with this file, then save.
// No extra images, CSS files, React components, or npm packages are needed.
// The inquiry form PREPARES an email; the visitor sends it in their email app.
// Edit your contact details, packages, and discount in this section.
const SITE = 'https://albrechtwebco.net/';
const EMAIL = 'Albrechtp919@gmail.com';
const PHONE = '+18167386774';
const VETERAN_DISCOUNT = 0.15;
const title = 'Albrecht Web Co. | Military-Owned Website Design';
const description = 'Military-owned web design for ambitious businesses. Detailed, interactive websites built for mobile and desktop. Packages from $300.';
const plans = [
  { id: 'basic', name: 'Basic', price: 300, monthly: 0, label: 'A strong first move.', text: 'A professional foundation that introduces your business and makes the next step clear.', features: ['Custom one-page website', 'Mobile, tablet & desktop layouts', 'Services, about & contact sections', 'Search-friendly page structure', 'One revision round'] },
  { id: 'professional', name: 'Professional', price: 600, monthly: 0, label: 'Room for your next chapter.', text: 'A more detailed presence for an established business with more services, work, and ideas to share.', features: ['Everything in Basic', 'Up to five custom pages', 'Expanded service or work showcases', 'Custom interactive elements', 'Two revision rounds', 'Two content update rounds per year'] },
  { id: 'deluxe', name: 'Deluxe', price: 1300, monthly: 100, label: 'Make the full impression.', text: 'An ambitious custom experience with more depth, expressive motion, and attention to every detail.', features: ['Everything in Professional', 'Up to eight custom pages', 'Advanced 3D & motion design', 'Custom layouts and interactions', 'Technical & on-page SEO setup', 'Three revision rounds', 'Ongoing website care: $100/month'] },
];
const money = (value: number) => new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 2 }).format(value).replace(/\.00$/, '');
const discountPercent = Math.round(VETERAN_DISCOUNT * 100);
const stars = Array.from({ length: 9 }, (_, row) => Array.from({ length: row % 2 === 0 ? 6 : 5 }, (_, col) => ({
  x: (760 / 12) * (col * 2 + (row % 2 === 0 ? 1 : 2)),
  y: (7000 / 130) * (row + 1),
}))).flat();
const starPoints = Array.from({ length: 10 }, (_, i) => {
  const angle = -Math.PI / 2 + i * Math.PI / 5;
  const radius = i % 2 === 0 ? 30.8 : 11.76;
  return `${Math.cos(angle) * radius},${Math.sin(angle) * radius}`;
}).join(' ');
const faqs = [
  { q: 'Will my website work on my phone?', a: 'Yes. Every package includes layouts for phones, tablets, and computers. Text stays readable, navigation is easy to reach, and the design adapts to your screen.' },
  { q: 'What is included in the price?', a: 'Each upfront price covers the website build described above. Deluxe is $1,300 upfront plus $100 per month in ongoing website fees. Domain registration, hosting, paid integrations, and work outside the agreed scope are separate. We confirm the details before your project begins.' },
  { q: `How does the ${discountPercent}% veteran discount work?`, a: `Eligible veterans receive ${discountPercent}% off the website build fee and the Deluxe monthly website fee. Turn on veteran pricing to see the estimate, and mention your eligibility when you get in touch.` },
  { q: 'What do the Professional update rounds cover?', a: 'Professional and Deluxe include two content update rounds per year. We agree on the scope of those updates before work begins. New pages, redesigns, and additional functionality can be quoted separately.' },
  { q: 'What do you need from me?', a: 'Your business name, services, contact information, and any logo, photos, or copy you already have. We will discuss your goals and identify anything else the project needs.' },
  { q: 'How do we get started?', a: 'Choose a package and prepare a project inquiry below, or contact me directly. We will discuss the scope, content, and timeline together before any work begins.' },
];
const schema = {
  '@context': 'https://schema.org', '@type': 'Organization', name: 'Albrecht Web Co.', url: SITE, description, email: EMAIL, telephone: PHONE,
  hasOfferCatalog: { '@type': 'OfferCatalog', name: 'Website design packages', itemListElement: plans.map(p => ({ '@type': 'Offer', name: p.name, description: p.monthly ? `${p.name}: ${money(p.price)} upfront plus ${money(p.monthly)} per month in ongoing website fees.` : `${p.name}: ${money(p.price)} one-time website build.`, price: p.price, priceCurrency: 'USD', url: `${SITE}#packages`, itemOffered: { '@type': 'Service', name: `${p.name} website design` } })) },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#080e1a" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={SITE} />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='15' fill='%23080e1a'/%3E%3Cpath d='M12 49 28 14h8l16 35H41l-3-8H25l-3 8zm16-17h7l-3.5-9z' fill='%239bd6ff'/%3E%3C/svg%3E" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={SITE} />
    <meta property="og:site_name" content="Albrecht Web Co." />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="ambient-light" aria-hidden="true"></div>
    <header class="header">
      <div class="shell header-inner">
        <a class="brand" href="#home" aria-label="Albrecht Web Co. home">
          <span class="brand-mark" aria-hidden="true">A<span>/</span></span>
          <span class="brand-name">ALBRECHT<span>WEB CO.</span></span>
        </a>
        <button class="menu-button" type="button" aria-expanded="false" aria-controls="navigation" hidden>Menu <span aria-hidden="true">+</span></button>
        <nav id="navigation" aria-label="Main navigation">
          <a href="#approach">The approach</a>
          <a href="#packages">The packages</a>
          <a class="nav-contact" href="#contact">Let’s build <span aria-hidden="true">↗</span></a>
        </nav>
      </div>
    </header>

    <main id="main">
      <section class="hero shell" id="home" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow"><span class="small-star" aria-hidden="true">✦</span> Military owned &amp; operated</p>
          <h1 id="hero-title">Built to<br />make an<br /><span>impact.</span></h1>
          <p class="hero-lead">Your business has ambition.<br />Your website should show it.</p>
          <p class="hero-description">Custom websites with presence, purpose, and the discipline to get every detail right.</p>
          <div class="hero-actions">
            <a class="button primary" href="#packages">Explore packages <span aria-hidden="true">↗</span></a>
            <a class="text-link" href="#contact">Let’s talk <span aria-hidden="true">→</span></a>
          </div>
          <div class="hero-footnote"><span>Independent.<br /><strong>By design.</strong></span><span>Personal attention.<br /><strong>From start to launch.</strong></span></div>
        </div>

        <div class="hero-visual">
          <div class="scene" id="scene">
            <div class="scene-grid" aria-hidden="true"></div>
            <div class="scene-ground" aria-hidden="true"></div>
            <div class="scene-object" id="scene-object" aria-hidden="true">
              <div class="flag-surface">
                <svg class="flag-fallback" viewBox="0 0 1900 1000" focusable="false">
                  <defs><polygon id="flag-star" points={starPoints} /></defs>
                  <rect width="1900" height="1000" fill="#f0efeb" />
                  {Array.from({ length: 7 }, (_, i) => <rect x="0" y={i * 2000 / 13} width="1900" height={1000 / 13} fill="#b31942" />)}
                  <rect width="760" height={7000 / 13} fill="#0a3161" />
                  {stars.map(star => <use href="#flag-star" x={star.x} y={star.y} fill="#fff" />)}
                </svg>
                <canvas id="flag-canvas"></canvas>
              </div>
              <div class="screen-depth depth-back"></div>
              <div class="screen-depth depth-middle"></div>
              <div class="showcase-screen">
                <div class="screen-chrome"><span class="chrome-dots"><i></i><i></i><i></i></span><span>YOUR NEXT CHAPTER</span><span>↗</span></div>
                <div class="screen-content">
                  <div class="screen-topline"><span>YOUR BRAND.</span><span>EST. TODAY</span></div>
                  <div class="screen-orb"></div>
                  <p class="screen-headline">A new<br /><em>perspective.</em></p>
                  <div class="screen-bottom"><span>Built around your ambition.</span><span class="screen-arrow">↗</span></div>
                </div>
              </div>
              <div class="floating-tag tag-front"><span class="tag-symbol">✦</span><span>DETAILS MATTER.<br /><strong>Every single one.</strong></span></div>
              <div class="floating-tag tag-side"><span class="tag-index">01 /</span><span>BUILT AROUND YOU</span></div>
              <div class="scene-ring ring-one"></div><div class="scene-ring ring-two"></div>
            </div>
            <p class="sr-only">A dimensional website concept in front of a waving American flag.</p>
          </div>
          <div class="visual-controls" hidden>
            <div class="scene-buttons" role="group" aria-label="Rotate the 3D preview">
              <button type="button" data-rotate="-1" aria-label="Rotate preview left">↶</button>
              <button type="button" id="reset-scene">Reset view</button>
              <button type="button" data-rotate="1" aria-label="Rotate preview right">↷</button>
            </div>
            <button class="motion-button" id="motion-button" type="button" aria-pressed="false">Pause motion</button>
          </div>
          <div class="palette-row" hidden>
            <div class="palette" role="group" aria-label="Preview an accent color">
              <span>Make it yours.</span>
              <button class="swatch ice" data-theme="ice" type="button" aria-label="Ice blue accent" aria-pressed="true"></button>
              <button class="swatch copper" data-theme="copper" type="button" aria-label="Copper accent" aria-pressed="false"></button>
              <button class="swatch mint" data-theme="mint" type="button" aria-label="Mint accent" aria-pressed="false"></button>
            </div>
            <span class="drag-hint">Drag to explore</span>
          </div>
        </div>
      </section>

      <div class="standards">
        <div class="shell standards-inner"><span><b>01 /</b> Thoughtful design</span><span><b>02 /</b> Made for mobile</span><span><b>03 /</b> Built with purpose</span></div>
      </div>

      <section class="shell section approach" id="approach" aria-labelledby="approach-title">
        <div class="section-intro"><p class="eyebrow">01 / The approach</p><h2 id="approach-title">Good design.<br /><span>Clear purpose.</span></h2><p>Your website should make it easy to understand your business, trust your work, and take the next step.</p><a class="text-link" href="#contact">A conversation comes first <span aria-hidden="true">↗</span></a></div>
        <div class="approach-list">
          <article><span class="item-number">01</span><div><h3>A presence that feels like you.</h3><p>Your message, your customers, your goals. The design starts there.</p></div><span class="item-symbol" aria-hidden="true">◇</span></article>
          <article><span class="item-number">02</span><div><h3>Easy to explore. Easy to act.</h3><p>Clear navigation and thoughtful interactions, from a phone in your hand to a full desktop screen.</p></div><span class="item-symbol" aria-hidden="true">↗</span></article>
          <article><span class="item-number">03</span><div><h3>Discipline in the details.</h3><p>Military owned and operated. Direct communication and personal attention from first conversation to launch.</p></div><span class="item-symbol" aria-hidden="true">✦</span></article>
        </div>
      </section>

      <section class="pricing-section" id="packages" aria-labelledby="pricing-title">
        <div class="shell section">
          <div class="section-heading"><div><p class="eyebrow">02 / Your next move</p><h2 id="pricing-title">Big ambition.<br /><span>Clear pricing.</span></h2></div><p>Choose the starting point that fits your business. Every package is made for mobile, tablet, and desktop.</p></div>
          <div class="pricing-toolbar" hidden>
            <div class="goal-picker" role="group" aria-label="Match a package to your business">
              <button type="button" data-goal="basic" aria-pressed="false">I’m launching</button>
              <button type="button" data-goal="professional" aria-pressed="true">I’m growing</button>
              <button type="button" data-goal="deluxe" aria-pressed="false">I want more</button>
            </div>
            <label class="veteran-control"><input type="checkbox" data-veteran /><span class="switch-track" aria-hidden="true"></span><span>Veteran pricing <strong>−{discountPercent}%</strong></span></label>
          </div>
          <p class="recommendation" id="recommendation" role="status" hidden>Professional gives an established business room to grow.</p>
          <div class="package-grid">
            {plans.map((plan, i) => (
              <article class:list={['package', { recommended: plan.id === 'professional' }]} id={plan.id} data-package={plan.id} data-tilt>
                <div class="package-top"><span>PACKAGE / 0{i + 1}</span><span class="selected-label">SUGGESTED FIT</span></div>
                <h3>{plan.name}</h3><p class="package-label">{plan.label}</p>
                <p class="price-line"><span data-price={plan.price}>{money(plan.price)}</span><small>USD / build</small></p>
                <p class="one-time">{plan.monthly ? <><strong>+ <span data-monthly={plan.monthly}>{money(plan.monthly)}</span> / month</strong><span class="monthly-description">Ongoing website fees</span></> : "One-time website build"}</p>
                <p class="saving" data-saving={plan.price}></p>
                <p class="package-description">{plan.text}</p>
                <ul>{plan.features.map(feature => <li>{feature.includes("$100/month") ? <>Ongoing website care: <span data-monthly={plan.monthly}>{money(plan.monthly)}</span>/month</> : feature}</li>)}</ul>
                <a class:list={['button', plan.id === 'professional' ? 'primary' : 'secondary']} href="#contact" data-plan-select={plan.id}>Choose {plan.name}<span aria-hidden="true">↗</span></a>
              </article>
            ))}
          </div>
          <div class="pricing-notes"><p><strong>{discountPercent}% off for veterans.</strong> Eligibility is confirmed when we discuss your project.</p><p>Domain, hosting, and paid third-party services are separate. Scope and terms are agreed before work begins.</p></div>
          <p class="sr-only" id="pricing-status" role="status" aria-atomic="true"></p>
        </div>
      </section>

      <section class="shell section questions" aria-labelledby="faq-title">
        <div><p class="eyebrow">A few things to know</p><h2 id="faq-title">Clarity.<br /><span>From day one.</span></h2></div>
        <div class="faq-list">{faqs.map(faq => <details><summary>{faq.q}<span aria-hidden="true">+</span></summary><p>{faq.a}</p></details>)}</div>
      </section>

      <section class="contact-section" id="contact" aria-labelledby="contact-title">
        <div class="shell section contact-grid">
          <div class="contact-copy"><p class="eyebrow">03 / Let’s build</p><h2 id="contact-title">Your next move<br />starts <span>here.</span></h2><p>Tell me what you’re building.<br />Let’s give it a website with presence.</p>
            <div class="contact-person"><span class="contact-initial" aria-hidden="true">PA</span><span><strong>Parker Albrecht</strong><br />Owner · Albrecht Web Co.</span></div>
            <a class="contact-link" href={`mailto:${EMAIL}`}>{EMAIL}<span aria-hidden="true">↗</span></a>
            <a class="contact-link" href={`tel:${PHONE}`}>(816) 738-6774<span aria-hidden="true">↗</span></a>
            <p class="contact-owned">Military owned &amp; operated.</p>
          </div>
          <form id="inquiry-form" data-email={EMAIL} data-discount={VETERAN_DISCOUNT} hidden>
            <div class="form-topline"><h3>A little about your project.</h3><span aria-hidden="true">↗</span></div>
            <div class="form-row"><label>Your name<input name="name" autocomplete="name" required maxlength="80" placeholder="Your name" /></label><label>Your business<input name="business" autocomplete="organization" required maxlength="120" placeholder="Business name" /></label></div>
            <label>Email address<input name="email" type="email" autocomplete="email" required maxlength="180" placeholder="you@yourbusiness.com" /></label>
            <label>Your package<select name="package" id="package-select">{plans.map(plan => <option value={plan.id} data-price={plan.price} data-monthly={plan.monthly} data-name={plan.name} selected={plan.id === 'professional'}>{plan.name} — {money(plan.price)}{plan.monthly ? ` + ${money(plan.monthly)}/month` : ""}</option>)}</select></label>
            <label class="veteran-control form-veteran"><input type="checkbox" data-veteran name="veteran" /><span class="switch-track" aria-hidden="true"></span><span>I’m eligible for veteran pricing <strong>−{discountPercent}%</strong></span></label>
            <label>What do you have in mind?<textarea name="goals" rows="4" required maxlength="1200" placeholder="Your services, your goals, and what your website needs to do."></textarea></label>
            <div class="estimate"><span>Estimated build fee</span><output id="estimate-total" for="package-select">{money(600)}</output></div>
            <p class="recurring-estimate" id="estimate-recurring" hidden></p>
            <p class="form-note">Opens your email app. Nothing is sent automatically.</p>
            <div class="form-actions"><button class="button primary" type="submit">Prepare my inquiry <span aria-hidden="true">↗</span></button><button class="copy-button" type="button" id="copy-brief">Copy inquiry</button></div>
            <p class="form-status" id="form-status" role="status" aria-live="polite"></p>
            <textarea id="copy-output" aria-label="Your inquiry, ready to copy" rows="8" readonly hidden></textarea>
          </form>
          <noscript><div class="noscript-contact"><p>Email or call Parker to discuss your project and preferred package.</p><a class="button primary" href={`mailto:${EMAIL}`}>Email Parker ↗</a></div></noscript>
        </div>
      </section>
    </main>
    <footer class="shell footer"><a class="brand" href="#home"><span class="brand-mark" aria-hidden="true">A<span>/</span></span><span class="brand-name">ALBRECHT<span>WEB CO.</span></span></a><p>© {new Date().getFullYear()} Albrecht Web Co.</p><a class="text-link" href="#home">Back to top <span aria-hidden="true">↑</span></a></footer>

    <style is:global>
      :root { color-scheme: dark; --bg:#080e1a; --surface:#101b2c; --ink:#f2f5fc; --muted:#aab8cd; --line:rgba(177,200,237,.18); --accent:#9bd6ff; --accent-rgb:155,214,255; --ink-on-accent:#071422; --radius:18px; }
      *,*::before,*::after { box-sizing:border-box; }
      html { scroll-behavior:smooth; scroll-padding-top:112px; }
      body { margin:0; background:var(--bg); color:var(--ink); font-family:Inter,"Avenir Next",Avenir,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif; font-size:16px; line-height:1.6; padding-left:env(safe-area-inset-left); padding-right:env(safe-area-inset-right); padding-bottom:env(safe-area-inset-bottom); -webkit-font-smoothing:antialiased; }
      body::before { content:""; position:absolute; inset:0 0 auto; height:980px; background:radial-gradient(ellipse at 82% 33%,#162f574d,transparent 52%); pointer-events:none; z-index:-1; }
      ::selection { background:var(--accent); color:var(--ink-on-accent); }
      a { color:inherit; text-decoration:none; }
      button,input,select,textarea { font:inherit; }
      button,a,input,select,textarea,summary { -webkit-tap-highlight-color:transparent; }
      button { cursor:pointer; }
      button,a { touch-action:manipulation; }
      button { color:inherit; }
      input,select,textarea { max-width:100%; min-width:0; }
      [hidden] { display:none!important; }
      :focus-visible { outline:3px solid var(--accent); outline-offset:5px; }
      h1,h2,h3,p { margin:0; }
      h1,h2,h3 { line-height:1.06; font-weight:650; }
      .shell { width:min(1280px,calc(100% - 96px)); margin-inline:auto; }
      .section { padding-block:112px; }
      .eyebrow { font-size:.875rem; font-weight:600; letter-spacing:.1em; text-transform:uppercase; color:var(--accent); }
      .small-star { font-size:1.35rem; vertical-align:middle; margin-right:9px; }
      h2 { font-size:clamp(2.3rem,4.5vw,4.5rem); letter-spacing:-.045em; }
      h2 span { color:var(--muted); }
      .sr-only { position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; border:0; }
      .skip-link { position:fixed; top:10px; left:16px; transform:translateY(-160%); padding:12px 20px; z-index:100; background:var(--accent); color:var(--ink-on-accent); border-radius:8px; }
      .skip-link:focus { transform:translateY(0); }
      .ambient-light { position:fixed; left:var(--mouse-x,65%); top:var(--mouse-y,24%); width:420px; height:420px; transform:translate(-50%,-50%); background:radial-gradient(circle,rgba(var(--accent-rgb),.035),transparent 65%); pointer-events:none; z-index:2; }
      .header { position:sticky; top:0; z-index:30; background:rgba(8,14,26,.94); border-bottom:1px solid var(--line); backdrop-filter:blur(16px); -webkit-backdrop-filter:blur(16px); }
      .header-inner { min-height:94px; display:flex; align-items:center; justify-content:space-between; gap:20px; }
      .brand { display:inline-flex; align-items:center; gap:12px; flex-shrink:0; }
      .brand-mark { font-weight:800; font-size:2.35rem; letter-spacing:-.18em; width:48px; line-height:1; color:var(--accent); }
      .brand-mark>span { color:var(--ink); font-weight:400; font-size:1.9rem; }
      .brand-name { font-size:.875rem; font-weight:750; letter-spacing:.13em; line-height:1.25; }
      .brand-name>span { display:block; color:var(--muted); font-size:.75rem; font-weight:500; letter-spacing:.2em; margin-top:5px; }
      .header nav { display:flex; align-items:center; gap:32px; font-size:.9375rem; }
      .header nav>a { min-height:44px; display:flex; align-items:center; transition:color .2s; }
      .header nav>a:hover { color:var(--accent); }
      .nav-contact { padding:9px 18px; border:1px solid var(--line); border-radius:8px; gap:28px; }
      .menu-button { display:none; background:none; border:1px solid var(--line); border-radius:8px; padding:8px 13px; min-height:44px; gap:14px; align-items:center; }
      .hero { position:relative; display:grid; grid-template-columns:1fr 1.08fr; align-items:center; gap:20px; padding-block:70px 84px; }
      .hero-copy { position:relative; z-index:3; }
      .hero h1 { font-size:clamp(4.5rem,7.45vw,7.8rem); letter-spacing:-.062em; margin-top:26px; line-height:.96; }
      .hero h1>span { color:var(--accent); text-shadow:0 5px 0 rgba(var(--accent-rgb),.075),0 18px 44px rgba(var(--accent-rgb),.08); }
      .hero-lead { margin-top:30px; font-size:1.3125rem; line-height:1.45; font-weight:500; }
      .hero-description { color:var(--muted); max-width:355px; margin-top:17px; font-size:1rem; }
      .hero-actions { display:flex; align-items:center; flex-wrap:wrap; gap:28px; margin-top:30px; }
      .button { min-height:54px; display:inline-flex; align-items:center; justify-content:space-between; gap:24px; padding:14px 23px; border:1px solid transparent; border-radius:9px; font-size:1rem; font-weight:650; line-height:1.4; transition:transform .2s,box-shadow .2s,background .2s; }
      .button:hover { transform:translateY(-3px); box-shadow:0 12px 28px #0003; }
      .primary { background:var(--accent); color:var(--ink-on-accent); box-shadow:inset 0 1px 0 #ffffff70,0 5px 0 rgba(var(--accent-rgb),.12); }
      .secondary { border-color:var(--line); background:#142137; color:var(--ink); }
      .secondary:hover { border-color:var(--accent); }
      .text-link { display:inline-flex; min-height:44px; align-items:center; gap:20px; font-weight:500; }
      .text-link:hover { color:var(--accent); }
