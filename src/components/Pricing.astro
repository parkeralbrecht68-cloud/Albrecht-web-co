---
import { packages, packageScope, maintenance } from "../data/studio";
const { route = false } = Astro.props;
---

<section
  class:list={["pricing-section", "section-pad", { "route-section": route }]}
  id="pricing"
  aria-labelledby="pricing-heading"
>
  <div class="shell">
    <div class="section-topline">
      <p class="eyebrow">03 / Your next move</p>
      <span class="small-label">Clear packages. Personal attention.</span>
    </div>
    <div class="section-heading">
      <div>
        {route ? (
          <h1 id="pricing-heading">
            Match your
            <br />
            <span>ambition.</span>
          </h1>
        ) : (
          <h2 id="pricing-heading">
            Match your
            <br />
            <span>ambition.</span>
          </h2>
        )}
        <p>Small businesses. Big ideas. A website within reach.</p>
      </div>
      <div class="discount-box">
        <label class="discount-control">
          <input
            id="veteran-toggle"
            type="checkbox"
            aria-describedby="discount-note"
          />
          <span class="toggle-track" aria-hidden="true"></span>
          <span>
            Veteran pricing <strong>−15%</strong>
          </span>
        </label>
        <p id="discount-note">
          Military owned & operated. Thank you for your service.
        </p>
      </div>
    </div>
    <p
      class="sr-only"
      id="pricing-announcement"
      aria-live="polite"
      aria-atomic="true"
    ></p>
    <p class="scope-guide-note">
      <strong>A planning guide for your quote.</strong> {packageScope.note}
    </p>
    <div class="pricing-grid">
      {packages.map((plan) => (
        <article
          class:list={["price-card", { featured: plan.id === "professional" }]}
          data-plan={plan.id}
        >
          <div class="card-top">
            <span>{plan.number}</span>
            <span>
              {plan.id === "professional"
                ? "Built for growth"
                : plan.id === "basic"
                  ? "The foundation"
                  : "The full experience"}
            </span>
          </div>
          <h3>{plan.name}</h3>
          <p class="plan-tagline">{plan.tagline}</p>
          <div class="price-area">
            <div class="price-line">
              <span class="price-value" data-base-price={plan.price}>
                ${plan.price.toLocaleString("en-US")}
              </span>
              <span>one time</span>
            </div>
            <p class="monthly-line">
              Optional maintenance available
            </p>
            <p class="savings-line" data-saving-base={plan.price}></p>
          </div>
          <p class="plan-description">{plan.description}</p>
          <dl class="plan-scope" aria-label={`${plan.name} proposed scope`}>
            <div><dt>Pages</dt><dd>Up to {plan.pageLimit}</dd></div>
            <div><dt>Design revisions</dt><dd>{plan.revisionRounds} rounds</dd></div>
            <div><dt>Estimated build</dt><dd>{plan.timeline}</dd></div>
          </dl>
          <ul class="features">
            {plan.features.map((feature) => (
              <li>{feature}</li>
            ))}
          </ul>
          <a
            class:list={[
              "button",
              plan.id === "professional" ? "button-blue" : "button-outline",
            ]}
            href={route ? `/contact/?package=${plan.id}` : "#contact"}
            data-select-plan={plan.id}
          >
            {plan.action}
          </a>
        </article>
      ))}
    </div>
    <div class="pricing-notes">
      <p>
        All prices in USD. Each website package is a one-time project purchase.
        Website maintenance is optional. The veteran discount applies to the
        project price and optional care.
      </p>
      <p>
        Domain, hosting, paid tools, and any expanded scope are priced separately
        and confirmed in your quote.
      </p>
    </div>
    <div class="care-option" aria-labelledby="care-heading">
      <div>
        <p class="eyebrow">After launch / Optional care</p>
        <h3 id="care-heading">Keep your website up to date.</h3>
        <p>{maintenance.description} Available with any package.</p>
        <p class="care-scope-note">{maintenance.scopeNote}</p>
      </div>
      <div class="care-price">
        <p>From <strong data-base-price={maintenance.price}>${maintenance.price}</strong><span> / month</span></p>
        <a
          class="text-link"
          href={route ? "/contact/?maintenance=true" : "#contact"}
          data-maintenance-select
        >Ask about optional care</a>
      </div>
    </div>
    <div class="scope-details" aria-label="Package questions">
      <details>
        <summary>How do revisions and updates work?</summary>
        <p>{packageScope.revisions}</p>
        <p>Business and Premium also include two website update rounds per year. Those post-launch updates are separate from the design revisions in your quote.</p>
      </details>
      <details>
        <summary>When could my website launch?</summary>
        <p>{packageScope.timeline}</p>
      </details>
      <details>
        <summary>What should I budget for a domain and hosting?</summary>
        <p>As a planning guide, many standard business domains cost about $10–$25 per year. Premium names, extensions, and renewal prices can cost more. Hosting may be free or carry a monthly fee, depending on the provider and features your site needs.</p>
        <p>Your quote separates the website build, domain registration, hosting, paid tools, and optional maintenance so you can see the full cost before starting.</p>
      </details>
    </div>
    <div class="package-helper">
      <div>
        <p class="eyebrow">Find your fit</p>
        <h3>
          What does your
          <br />
          business need?
        </h3>
      </div>
      <div>
        <label for="business-goal">Your main priority</label>
        <select id="business-goal">
          <option value="basic">Get my business online</option>
          <option value="professional">Showcase a growing business</option>
          <option value="deluxe">A premium site with advanced features</option>
        </select>
      </div>
      <div class="helper-result" aria-live="polite">
        <span class="eyebrow">Your starting point</span>
        <strong id="recommended-name">Starter</strong>
        <a
          id="recommended-link"
          class="text-link"
          href={route ? "/contact/?package=basic" : "#contact"}
          data-select-plan="basic"
        >
          Talk about this package
        </a>
      </div>
    </div>
  </div>
</section>
