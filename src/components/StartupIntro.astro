<dialog
  id="studio-intro"
  class="studio-intro"
  aria-labelledby="intro-name"
>
  <div class="intro-topline">
    <span>Independent digital studio</span>
    <button class="intro-skip" type="button" autofocus>
      Skip intro <span aria-hidden="true">↗</span>
    </button>
  </div>
  <div class="intro-center">
    <div class="intro-halo" aria-hidden="true"></div>
    <svg class="intro-logo" viewBox="0 0 96 96" aria-hidden="true">
      <defs>
        <linearGradient id="intro-silver" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#ffffff" />
          <stop offset=".42" stop-color="#c8d4e5" />
          <stop offset=".68" stop-color="#6d7a8e" />
          <stop offset="1" stop-color="#f4f7fc" />
        </linearGradient>
      </defs>
      <g class="intro-piece intro-piece-left">
        <path d="M14 78 40 18h8v26L36 78Z" fill="#26334a" transform="translate(0 3)" />
        <path d="M14 78 40 18h8v26L36 78Z" fill="url(#intro-silver)" />
      </g>
      <g class="intro-piece intro-piece-right">
        <path d="M48 18h8l26 60H60L48 44Z" fill="#26334a" transform="translate(0 3)" />
        <path d="M48 18h8l26 60H60L48 44Z" fill="url(#intro-silver)" />
      </g>
      <g class="intro-piece intro-piece-bar">
        <path d="M36 62h24v12H36z" fill="#26334a" transform="translate(0 3)" />
        <path d="M36 62h24v12H36z" fill="url(#intro-silver)" />
      </g>
    </svg>
    <div class="intro-name-wrap">
      <p id="intro-name" class="intro-name">Albrecht Web Co.</p>
      <span class="intro-sweep" aria-hidden="true"></span>
    </div>
    <p class="intro-caption">Built with purpose. Made to stand apart.</p>
  </div>
  <div class="intro-baseline" aria-hidden="true"><span></span></div>
</dialog>
